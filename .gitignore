# Environment files
*.env
.env.local
.env.*.local

# Database files
*.db
*.db-shm
*.db-wal
mycorrhizal.db

# TLS/SSL certificates
*.pem
*.key
*.crt
key.pem
cert.pem

# Uploaded files
backend/static/photos/
static/photos/

# docker-compose.yml bind-mount defaults when `docker compose up` is run from
# the repo root (DATA_PATH/PHOTOS_PATH/ATTACHMENTS_PATH: ./data ./photos
# ./attachments) — created root/uid-1001-owned by the container, never committed.
/data/
/photos/
/attachments/

# Build artifacts
backend/mycorrhizal
backend/main
# `go build ./cmd/perfbench` run from backend/ writes ./perfbench there.
backend/perfbench
# likewise `go build ./cmd/pentestseed` (issue #849).
backend/pentestseed
# `go build ./...` (or plain `go build .`) run from inside a cmd/<tool>/
# directory writes a same-named binary there — caught once for loadsmoke
# (issue #262), added generally so the next cmd/ tool doesn't repeat it.
backend/cmd/*/backup
backend/cmd/*/migrate
backend/cmd/*/backfill-search-index
backend/cmd/*/loadsmoke
backend/cmd/*/bolacheck
backend/cmd/*/schemagate
backend/cmd/*/deploysmoke
backend/cmd/*/pentestseed

# Go specific
*.test
*.out
vendor/
# Issue #268: gotestsum's JUnit XML + rerun-fails flake report, emitted in CI
# (uploaded as artifacts, never committed)
backend/junit.xml
backend/rerun-fails.txt

# Issue #369: Schemathesis JUnit reports, emitted in CI (uploaded as
# artifacts; the ignore-list schemathesis/schemathesis.ignore is tracked)
schemathesis/report/

# Frontend build
frontend/build/
frontend/dist/
frontend/node_modules/
node_modules/

# Issue #578: Stryker mutation report, emitted in CI (uploaded as an artifact;
# the stryker.conf.json scope is tracked)
frontend/reports/

# IDE specific
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# OS specific
.DS_Store
.DS_Store/
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/

# Testing
coverage/
*.cover
coverage.html
frontend/playwright-report/
frontend/test-results/
frontend/playwright/.auth/
# Playwright artifacts regardless of where they get written from
playwright-report/
test-results/
.last-run.json

# TypeScript incremental build info (e.g. from `tsc -b` on the e2e project)
*.tsbuildinfo

# Temporary files
*.tmp
*.temp
*.bak
*.backup
*~

# Ad-hoc debug/scratch scripts (should never be committed)
debug-*.mjs
debug-*.ts
debug-*.js
*-debug.mjs
*-debug.ts
*-debug.js
# CLAUDE.md is deliberately NOT ignored: it carries this repo's conventions and
# recurring bug classes, and is auto-loaded by coding agents. It has to be
# tracked to reach worktrees, other machines, and anyone else working here.
BACKLOG.md
fly.demo.toml
fly.test.toml
.aider*

# Compiled helper binary from `go build ./cmd/dastcanary` run in-tree.
/backend/dastcanary

# Local DAST scan output (zap-dast.yml uploads these as CI artifacts; the
# decision in issue #615 is that the SARIF is deliberately NOT uploaded to
# code scanning, so it must never land in git either).
/zap/

# TEST-08 differential reference build artifacts (issue #680): the calcard
# Rust CLI's target/ tree and the vobject reference script's Python bytecode
# cache are generated, never committed (Cargo.lock IS committed — it pins the
# reference's transitive dependency graph).
backend/differential/reference/calcard/target/
backend/differential/reference/vobject/__pycache__/
