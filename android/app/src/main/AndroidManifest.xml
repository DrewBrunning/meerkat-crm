<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- M1 item 12 (§7.6): the mobile link-action resolver queries
         ContactsContract.Data for the MIMETYPEs that prove an app is installed,
         which requires READ_CONTACTS. Requested inline (not at startup) when a
         known-protocol link is rendered; denied permission degrades the row to
         plain link + copy (§8.3). -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- Phase 4 tracking (§6.1/6.2): call-log + SMS capture, opt-in at runtime. -->
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Phase 4 quick-capture overlay (§6.5). -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Required for BootReceiver below: without this, Android never delivers
         BOOT_COMPLETED to the app, and the periodic tracking workers are never
         re-registered after a reboot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- The tracking permissions imply telephony/SMS hardware; mark them as
         not required so non-phone devices (tablets, ChromeOS) can still install. -->
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <uses-feature android:name="android.hardware.telephony.messaging" android:required="false" />

    <!-- Backups are disabled (this app holds contact data); the Android-12+
         dataExtractionRules file makes that explicit for cloud/device
         transfer, and allowBackup covers pre-Android-12. -->
    <application
        android:name=".MycorrhizalApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Mycorrhizal.Splash"
        tools:node="merge">
        <!-- The app provides WorkManager's Configuration via Configuration.Provider
             (Hilt worker factory), so remove the library's default initializer. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="remove" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- M5 §5: the OIDC native return. The backend's /auth/oidc/login
                 with client=android redirects here on success
                 (mycorrhizal://oidc/callback?token=…&language=…&date_format=…)
                 and with error=… on every failure. singleTask so the deep link
                 is delivered to the running activity (onNewIntent) rather than
                 stacking a second instance. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="mycorrhizal" android:host="oidc" android:pathPrefix="/callback" />
            </intent-filter>
        </activity>

        <!-- M24: shares exported vCard files via the system share sheet (ACTION_SEND with a
             content:// URI scoped to the app's cache). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Phase 4 quick-capture overlay foreground service (§6.7). Not a
             dialer/phoneCall function (that FGS type requires the default-dialer
             role or MANAGE_OWN_CALLS, which this app neither holds nor wants), so
             it is declared specialUse: it briefly shows an overlay after a call
             ends. The subtype property is required for specialUse on API 34+. -->
        <service
            android:name="com.mycorrhizal.crm.feature.tracking.CallDetectionService"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Shows the quick-capture interaction overlay for a short window after a phone call ends when call tracking is enabled" />
        </service>

        <!-- M5 §5a (issue #152): FCM push entry point. Registered in the manifest
             unconditionally; with no google-services.json the Firebase runtime
             never initializes and the service is simply never invoked, leaving
             the WorkManager polling workers as the sole push path. -->
        <service
            android:name="com.mycorrhizal.crm.feature.tracking.MyFirebaseMessagingService"
            android:exported="false"
            tools:ignore="Instantiatable">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Phase 4 tracking receivers (§6.3). -->
        <receiver
            android:name="com.mycorrhizal.crm.feature.tracking.PhoneStateReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.PHONE_STATE" />
            </intent-filter>
        </receiver>
        <receiver
            android:name="com.mycorrhizal.crm.feature.tracking.SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="0">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>
        <receiver
            android:name="com.mycorrhizal.crm.feature.tracking.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
