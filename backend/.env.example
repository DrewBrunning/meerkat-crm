# ── Deprecated variables ─────────────────────────────────────────────────────
# None currently. When a configuration variable is deprecated (MAINT-01,
# docs/deprecation-policy.md) it keeps working, unchanged, for its whole window
# — at least one minor release and at least 90 days — and the only change is a
# `WARN: <OLD> is deprecated (since vX.Y.Z); use <NEW> instead` line at boot.
# Every such variable is listed in docs/deprecations.md until it is removed.
# ─────────────────────────────────────────────────────────────────────────────

# Database Configuration
export SQLITE_DB_PATH='./static/mycorrhizal.db'

# Directory for the automatic pre-migration backup (issue #530). Before applying
# any pending migration, the server (startup) and `make migrate-up` write a
# verified SQLite snapshot here and REFUSE to migrate if they cannot — downgrade
# is unsupported, so this snapshot is the rollback point ("install the previous
# release, restore it"; see docs/operations/migration-recovery.md). This env var
# only MOVES the target; there is no setting that disables the backup.
# Default: a 'pre-migration/' subdirectory beside SQLITE_DB_PATH. Point it
# somewhere your backup-rotation cron will not sweep.
# export MYCORRHIZAL_PRE_MIGRATION_BACKUP_DIR='/backups/pre-migration'

# IMPORTANT: Must be an absolute path for security reasons (e.g., /var/data/mycorrhizal/photos)
export PROFILE_PHOTO_DIR='/path/to/photos'
# Attachments directory (N7 — file uploads per contact). Must be an absolute
# path for the same security reasons as the photo directory. Defaults alongside
# the photo dir when unset.
export ATTACHMENTS_DIR='/path/to/attachments'

# Security
# The server REFUSES to start with this placeholder JWT secret or any
# weak/known default: generate a fresh one, e.g. `openssl rand -base64 32`.
export JWT_SECRET_KEY='your-very-long-very-secret-jwt-key-change-this-in-production'
export JWT_EXPIRY_HOURS='96'

# At-rest field-level encryption (issue #380): sensitive columns (contact
# free text, the neutral card, life-event descriptions, reminder messages,
# gift notes, preferences, conversation agenda, audit snapshots, sync-conflict
# copies) are AES-256-GCM encrypted at rest. The master key is, in order:
#   1. DATA_ENCRYPTION_KEY  — base64, 32 bytes (`openssl rand -base64 32`)
#   2. DATA_ENCRYPTION_KEY_FILE — path to a file containing such a key
#   3. derived from JWT_SECRET_KEY (HKDF-SHA256), so a zero-config deployment
#      still encrypts.
# A dedicated key is recommended so rotating JWT_SECRET_KEY does not affect
# at-rest data. "Lost key = lost data, by design": there is no escrow. Key
# rotation (rewrap the DEK, payloads untouched) is `go run cmd/rotate-at-rest-key`.
# The searchable FTS columns (notes/activities/flat contact fields) stay
# plaintext by design so full-text search keeps working.
# export DATA_ENCRYPTION_KEY=''
# export DATA_ENCRYPTION_KEY_FILE='/etc/mycorrhizal/at-rest.key'


# Email notifications can be delivered via Resend, SMTP, or both. If both are set, every email is sent through both channels. Leave a section empty to disable that or both channels.

# Resend Email Configuration; https://resend.com/
export RESEND_API_KEY='YOUR_RESEND_API_KEY'
export RESEND_FROM_EMAIL='your-from-email@example.com'

# SMTP Email Configuration
# export SMTP_HOST='smtp.example.com'
# export SMTP_PORT='587'                 # default 587 (STARTTLS); use 465 with SMTP_USE_TLS=true
# export SMTP_USERNAME='your-username'   # optional; leave empty for unauthenticated relay
# export SMTP_PASSWORD='your-password'
# export SMTP_FROM_EMAIL='your-from-email@example.com'
# export SMTP_USE_TLS='false'            # true = implicit TLS (port 465); false = plaintext/STARTTLS

# Server Configuration (port is for backend, not frontend!)
# NOTE: the variable is PORT. This sample said HOST_PORT until 2026-08-06, which
# the backend never read — setting it moved nothing off 8080.
export PORT='8080'
export TRUSTED_PROXIES=''

# API rate limiting: one token every INTERVAL_MS, up to BURST tokens, per client
# IP. Defaults below. The e2e stack raises these enormously
# (docker-compose.test.yml) because the whole suite shares one IP.
export API_RATE_LIMIT_INTERVAL_MS='600'
export API_RATE_LIMIT_BURST='1000'

# Enable the CardDav server for contact sync (default is false)
export CARDDAV_ENABLED='true'

# Calendar sync (CalDAV/iCS activity import)
# Stored calendar passwords are encrypted with a key derived from JWT_SECRET_KEY;
# changing JWT_SECRET_KEY means calendar passwords must be re-entered.
export CALDAV_SYNC_INTERVAL_HOURS='6'    # how often subscribed calendars are synced (default 6)
export CALDAV_BLOCK_PRIVATE_URLS='false' # block calendar URLs resolving to private/loopback addresses, relevant for cloud or multi-tenant (prevent SSRF)
export DELETED_RETENTION_DAYS='30'       # how long soft-deleted contacts/notes/activities survive before permanent purge (default 30; 0 disables the purge, negative is rejected at startup)
export CONTACT_SHARE_RETENTION_DAYS='30' # how long a pending/declined/accepted contact-share snapshot survives before permanent purge (default 30, issue #574)
export SYSTEM_EVENT_RETENTION_DAYS='30'  # how long operational system_events (the /system-events timeline) survive before purge (default 30, issue #424)
export WEBHOOK_DELIVERY_RETENTION_DAYS='30' # how long webhook_deliveries rows (each carrying a copy of the entity that triggered the event) survive before purge (default 30, issue #622)

# Storage-growth trend thresholds (issue #652). /admin/system-status folds the
# filesystem's used-percent against these two tiers into ok | warning | critical
# (with -5% hysteresis, so a disk hovering at the threshold does not flap), and
# a warning/critical tier elevates the overall status to at least degraded. The
# daily storage sampler keeps ~STORAGE_SAMPLE_RETENTION_DAYS of history behind
# the trend block.
export STORAGE_WARN_PERCENT='75'           # usage% >= this turns the storage threshold warning (default 75)
export STORAGE_CRITICAL_PERCENT='90'       # usage% >= this turns it critical (default 90)
export STORAGE_SAMPLE_RETENTION_DAYS='180' # days of storage_samples history kept before the sampler prunes it (default 180)

# Immich integration (T15/T16). The Immich base URL is user-supplied in the UI
# and is typically a PRIVATE self-hosted address (http://immich:2283 or a LAN
# host), which is exactly why IMMICH_BLOCK_PRIVATE_URLS defaults to 'false' —
# blocking private addresses by default would make the integration useless for
# most self-hosters. Set it to 'true' for cloud/multi-tenant deployments. The
# user-supplied Immich API key is stored encrypted at rest (derived from
# JWT_SECRET_KEY, like calendar passwords).
export IMMICH_SYNC_INTERVAL_HOURS='6'    # how often the Immich enrichment sync runs (default 6)
export IMMICH_BLOCK_PRIVATE_URLS='false' # block Immich fetches resolving to private/loopback addresses (prevent SSRF)

# File-sharing integrations (P2a/P2b/P2c — Paperless-ngx, Seafile,
# Nextcloud/ownCloud WebDAV). Same SSRF trade-off as IMMICH_BLOCK_PRIVATE_URLS:
# server URLs are entered per-user in the UI and are typically PRIVATE
# self-hosted addresses, so blocking is off by default and should be enabled
# only for cloud/multi-tenant deployments. Per-user credentials (Paperless/
# Seafile API tokens, Nextcloud app passwords) are stored encrypted at rest
# (derived from JWT_SECRET_KEY, like calendar passwords).
export PAPERLESS_BLOCK_PRIVATE_URLS='false' # block Paperless fetches resolving to private/loopback addresses (prevent SSRF)
export SEAFILE_BLOCK_PRIVATE_URLS='false'   # block Seafile fetches resolving to private/loopback addresses (prevent SSRF)
export WEBDAV_BLOCK_PRIVATE_URLS='false'    # block Nextcloud/ownCloud WebDAV fetches resolving to private/loopback addresses (prevent SSRF)
# Monica import assistant (issue #549): the user enters their Monica instance
# URL in the UI, so this is the SSRF knob for that fetch. Self-hosted Monica
# usually lives on a LAN, so it defaults to false; set true on a cloud deploy.
export MONICA_BLOCK_PRIVATE_URLS='false'    # block Monica import fetches resolving to private/loopback addresses (prevent SSRF)

# Disable new user registration (default is false)
export DISABLE_REGISTRATION='false'

# Block webhook deliveries AND notification-channel posts (ntfy/Gotify, N9) to
# private/loopback addresses (default is false), relevant for cloud or
# multi-tenant (prevent SSRF). Self-hosted ntfy/Gotify instances are usually on
# private addresses — leave false to reach them.
#
# This is the ONLY server-side setting for the ntfy/Gotify/browser-push
# channels. Everything else about them is per-user, in Settings → Notifications
# (ntfy URL+topic, Gotify URL+token, registered push devices). The Web Push
# VAPID keypair is generated once on first use into the server_settings table,
# so there is nothing to configure — but browsers will not register the service
# worker on a plain-HTTP origin, so push needs HTTPS or localhost.
export WEBHOOK_BLOCK_PRIVATE_URLS='false'

# Mobile push delivery (M2). Set FCM_SERVICE_ACCOUNT_FILE to the path of a
# Firebase service-account JSON (project_id, client_email, private_key) to
# enable delivering reminder push notifications to registered Android (FCM)
# devices. When unset, mobile push delivery is disabled — Android devices can
# still register tokens via the API (POST /notifications/devices), but nothing
# is sent to them until this is configured. The web Push VAPID path above is
# unaffected.
export FCM_SERVICE_ACCOUNT_FILE=''

# Reminder Configuration (HH:MM format, in the timezone specified below).
# Server-wide: every user on the deployment shares this one clock (no per-user
# timezone). DST/29-Feb semantics: docs/adrs/0015-temporal-semantics.md.
export REMINDER_TIME='06:00'
# Timezone for reminder scheduling. Must be a valid IANA timezone name.
export REMINDER_TIMEZONE='UTC'

# "*" allows any origin via AllowOriginFunc and is DEV-ONLY: the server will
# refuse to start with FRONTEND_URL='*' when GIN_MODE=release. Set this to
# your actual frontend origin in production (e.g., https://crm.example.com).
export FRONTEND_URL='*'

# HTTP Server Timeouts (in seconds)
export HTTP_READ_TIMEOUT='15'    # Maximum duration for reading the entire request
export HTTP_WRITE_TIMEOUT='15'   # Maximum duration for writing the response
export HTTP_IDLE_TIMEOUT='60'    # Maximum time to wait for the next request (keep-alive)

# Observability: Prometheus metrics endpoint (issue #389). Opt-in, off by
# default. Set a random 16+ char token to expose GET /metrics; scrapes must
# then send `Authorization: Bearer <token>`. Empty = route not registered.
export METRICS_TOKEN=''

# Client/server compatibility floor (issues #528 + #692, docs/client-compatibility-policy.md).
# The oldest Android client versionName this server still supports, advertised
# on the unauthenticated GET /health as `min_client_version`. When set, it is
# ALSO ENFORCED at authentication (issue #692): every session-minting route
# (register, login, the 2FA step, the device-grant exchange) refuses a client
# whose `X-Client-Version` header is absent, is not a strict major.minor.patch,
# or is below this floor — before any credential work. Empty (the default) = no
# floor declared: every released client stays compatible. Set it ONLY when a
# genuinely breaking API change (MAINT-02, issue #491) strands older clients —
# a floor is a deliberate, reviewed event, never a side effect of a release.
# Must look like a versionName (e.g. '0.6.0'); a malformed value refuses to
# boot rather than silently failing open on clients.
# export MIN_CLIENT_VERSION=''

# Cookie Configuration
#
# 'false' is fine for plain-HTTP self-hosting (LAN, localhost, or a reverse
# proxy that hasn't added TLS yet). Set to 'true' once FRONTEND_URL above is
# https:// — the server refuses to start with an https:// FRONTEND_URL and
# COOKIE_SECURE=false, since that combination has no legitimate use (only a
# forgotten setting) and would send the auth cookie without the Secure flag.
export COOKIE_SECURE='false'

# Leave empty (recommended) so auth_token is a host-only cookie valid for
# exactly the host you opened the app on. A mismatched value makes the browser
# discard the cookie silently, which presents as a login redirect loop; an IP
# address never works. Only set it for split frontend/API subdomains
# (e.g. '.example.com'), which also exposes the cookie to sibling subdomains.
export COOKIE_DOMAIN=''
